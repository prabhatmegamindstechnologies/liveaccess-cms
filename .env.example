# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://liveaccess:liveaccess_dev@localhost:5433/liveaccess
TEST_DATABASE_URL=postgres://liveaccess:liveaccess_dev@localhost:5433/liveaccess_test

# Admin panel path on liveaccess.ai (no slashes). Final name from Akash.
ADMIN_PATH=la-studio

# Local API server port
PORT=8787

# Local preview of the built site (pnpm dev:api serves .site-preview/ here, on this machine only)
PREVIEW_PORT=4000

# Signs the CMS access tokens. At least 32 random characters; use a different value in every environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Local only: allow the refresh cookie over http://localhost, and serve the admin preview's site files. Never set this in production.
CMS_INSECURE_COOKIES=1

# Folder that holds the current site's HTML files (the repo root until go-live)
SITE_ROOT=.

# Folder for images uploaded to the Media library (git-ignored)
MEDIA_ROOT=.media
