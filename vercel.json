{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:admin && if [ \"$VERCEL_ENV\" = \"production\" ]; then pnpm db:migrate; fi",
  "outputDirectory": "cms/dist",
  "redirects": [{ "source": "/", "destination": "/la-studio/", "permanent": false }],
  "rewrites": [{ "source": "/la-studio/:path*", "destination": "/la-studio/index.html" }]
}
