# Branded page for unknown URLs (Apache returns it with a real 404 status).
ErrorDocument 404 /404.html
ErrorDocument 403 /error.html
ErrorDocument 500 /error.html

# Hide the server signature (and the ServerAdmin address) on any remaining default error pages.
ServerSignature Off

# Extensionless URLs redirect to the real pages.
RewriteEngine On
RewriteRule ^(how-it-works|features|about|contact|get-app|faq|privacy-policy|terms-and-condition|delete-account|guides|process-areas|guide-[a-z-]+|area-[a-z-]+)/?$ /$1.html [R=301,L]

# /index.html and / are the same page; send the duplicate address to / (THE_REQUEST avoids a loop with the directory index).
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# HSTS: browsers use HTTPS only for the next year (ignored over plain HTTP).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Caching. CSS and JS are linked with ?v=, so a release changes the URL and they can be cached for a year.
# Images and video keep the same name between releases, so they get a shorter cache. HTML stays short so edits show up quickly.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|svg|webp|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
